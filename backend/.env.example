# Server
PORT=3001
NODE_ENV=development

# Auth - GENERATE A STRONG SECRET FOR PRODUCTION (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Twilio (get these from your Twilio console: https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+18885551234

# Public URL of this backend (Twilio will hit this for voice webhooks)
# In dev, use ngrok: https://abc123.ngrok.io
PUBLIC_URL=https://your-public-url.example.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
